    <string name="sync_mode_refresh_desc">믹스는 동기화할 때마다 새로운 트랙으로 업데이트됩니다</string>
    <string name="sync_mode_accumulate_desc">새 트랙이 이전 트랙 위에 쌓입니다</string>
