<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Home's Your record card and the record's screen (feature/record). -->
    <string name="record_eyebrow">Your record</string>
    <!-- The word after the card's big number of hours ("412 hours"); the number is set apart, larger. -->
    <plurals name="record_hours">
        <item quantity="one">hour</item>
        <item quantity="other">hours</item>
    </plurals>
    <!-- %1$s: the record's plays, already formatted with separators ("1,234"). -->
