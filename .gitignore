Desktop.ini

# Captures (Android Studio)
captures/

# Log files
*.log
node_modules/

# Cloudflare Workers local state and local secrets (infra/*)
.wrangler/
.dev.vars
*.pem
.worktrees/

# Superpowers visual-companion server artifacts (per-session local state)
.superpowers/

# Claude Code per-machine local state (the shared .claude/ config stays tracked)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Local spike/experiment artifacts — never commit (huge binaries, screenshots).
# The bare globs only matched spike/'s top level, leaving spike/clap/*.onnx and
# the WAV fixtures stageable — hundreds of MB one `git add spike/` away.
spike/*.png
spike/*.flac
spike/*.txt
spike/*.xml
spike/**/*.onnx
spike/**/*.wav
spike/**/__pycache__/

# CLAP sonic-recommendation spike fixtures — 515MB of ONNX models + WAVs that
# live under androidTest so the on-device spike can read them. Never commit.
app/src/androidTest/assets/clapspike/
.kotlin/
