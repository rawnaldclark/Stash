    { "key": "sidePadding", "const": "SIDE_PADDING_DP", "unit": "dp", "default": 24, "min": 0, "max": 48, "step": 1, "group": "Sides", "label": "Page side padding" },
    { "key": "centeredTitleInset", "const": "CENTERED_TITLE_INSET_DP", "unit": "dp", "default": 40, "min": 0, "max": 80, "step": 1, "group": "Sides", "label": "Centred title inset" },
