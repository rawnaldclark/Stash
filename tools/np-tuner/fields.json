    { "key": "artistSize", "const": "ARTIST_SIZE_SP", "unit": "sp", "default": 15, "min": 10, "max": 24, "step": 0.5, "group": "Artist · album", "label": "Size" },
    { "key": "artistLineHeight", "const": "ARTIST_LINE_HEIGHT_SP", "unit": "sp", "default": 20, "min": 10, "max": 36, "step": 0.5, "group": "Artist · album", "label": "Line height" },
    { "key": "artistLetterSpacing", "const": "ARTIST_LETTER_SPACING_SP", "unit": "sp", "default": 0, "min": -1, "max": 2, "step": 0.05, "group": "Artist · album", "label": "Letter spacing" },

