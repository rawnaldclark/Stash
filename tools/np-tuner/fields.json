    { "key": "titleToArtist", "const": "TITLE_TO_ARTIST_DP", "unit": "dp", "default": 4, "min": 0, "max": 32, "step": 1, "group": "Stack", "label": "Title → artist" },
    { "key": "artistToQuality", "const": "ARTIST_TO_QUALITY_DP", "unit": "dp", "default": 6, "min": 0, "max": 32, "step": 1, "group": "Stack", "label": "Artist → quality" },
    { "key": "infoToProgress", "const": "INFO_TO_PROGRESS_DP", "unit": "dp", "default": 16, "min": 0, "max": 48, "step": 1, "group": "Stack", "label": "Quality → progress bar" },
    { "key": "progressToControls", "const": "PROGRESS_TO_CONTROLS_DP", "unit": "dp", "default": 12, "min": 0, "max": 48, "step": 1, "group": "Stack", "label": "Progress bar → controls" },
    { "key": "controlsToUpNext", "const": "CONTROLS_TO_UP_NEXT_DP", "unit": "dp", "default": 2, "min": 0, "max": 32, "step": 1, "group": "Stack", "label": "Controls → Up next" },

    { "key": "upNextHeight", "const": "UP_NEXT_HEIGHT_DP", "unit": "dp", "default": 40, "min": 24, "max": 64, "step": 1, "group": "Up next", "label": "Height" },
