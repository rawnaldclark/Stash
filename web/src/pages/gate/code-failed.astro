---
/** A wrong, used-up or expired code, or no code at all for that email: one answer for all of them. */
import GateShell from '../../components/gate/GateShell.astro';
import CodeForm from '../../components/gate/CodeForm.astro';
---

<GateShell title="That code didn't work" path="/gate/code-failed">
  <div class="gate-card glass">
    <p class="overline">Early access</p>
    <h1>That code didn't work</h1>
    <p>Each code works for 10 minutes and 5 tries. Check you're using the newest one, or get a new code.</p>
    <CodeForm />
    <form method="post" action="/access" class="resend">
      <input type="hidden" name="email" value="" data-value="email" />
      <input type="hidden" name="next" value="" data-value="next" />
      <button type="submit" class="button button-secondary button-small">Send a new code</button>
    </form>
    <p class="gate-small">Not on the list? <a href="/request">Request access</a>.</p>
  </div>
</GateShell>

<style>
  .resend {
    margin-top: 16px !important;
  }
</style>
