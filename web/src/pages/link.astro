---
/** Public page for opening the link pairing page on devices without the app. */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import vinyl from '../assets/brand/vinyl.png';
import { LINKS } from '../data/site';
---

<BaseLayout
  title="Link Stash on the web"
  description="Open this link on your Android phone with Stash installed to link it with Stash on the web."
  path="/link"
  noindex
>
  <section class="not-found">
    <div class="glow" aria-hidden="true"></div>
    <div class="container inner">
      <Image src={vinyl} alt="" width={140} height={140} densities={[1, 2]} loading="eager" class="record" />
      <h1>Open this on your phone</h1>
      <p class="lead">This link connects Stash on your Android phone with Stash on the web. Open it on the phone, with Stash installed, or scan the code on your computer with Stash.</p>
      <div class="actions">
        <a class="button button-primary" href={LINKS.download}><Icon name="download" size="20px" />Download Stash</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    position: relative;
    display: grid;
    place-items: center;
    min-height: calc(100vh - 64px - 200px);
    padding-block: clamp(64px, 10vw, 128px);
    isolation: isolate;
  }

  .glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(35% 45% at 50% 35%, var(--glow-purple), transparent 70%),
      radial-gradient(30% 40% at 70% 70%, var(--glow-magenta), transparent 70%);
    pointer-events: none;
  }

  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .inner :global(.record) {
    width: 140px;
    height: 140px;
    filter: drop-shadow(0 24px 48px rgb(139 92 246 / 0.45));
  }

  h1 {
    margin-top: 8px;
    font-size: clamp(2.25rem, 1.5rem + 3vw, 3.5rem);
    letter-spacing: -0.03em;
  }

  .lead {
    margin-top: 16px;
    max-width: 44ch;
    color: var(--text-2);
    font-size: 1.125rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }
</style>
