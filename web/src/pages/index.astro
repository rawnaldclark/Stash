---
/**
 * The home page. Each section is its own component in src/components/home/,
 * in the order they appear. To add a section, make a component there and
 * place it below.
 *
 * Everyone sees it. The Worker (worker/index.js) fills in this month's goal
 * and keeps the parts that fit the visitor (data-if="signed-in" or
 * "signed-out"): the web player section's sign-in form or its button to the
 * player, and the footer's Sign out button. The lossless section is for
 * signed-in visitors only, like the FAQ's lossless answer: the public page
 * keeps quality and sources out of its words.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Trust from '../components/home/Trust.astro';
import WebPlayer from '../components/home/WebPlayer.astro';
import Tutorial from '../components/home/Tutorial.astro';
import Library from '../components/home/Library.astro';
import Listening from '../components/home/Listening.astro';
import Lossless from '../components/home/Lossless.astro';
import Together from '../components/home/Together.astro';
import Faq from '../components/home/Faq.astro';
import Community from '../components/home/Community.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { SITE } from '../data/site';
---

<BaseLayout title={`${SITE.name}: ${SITE.tagline}`} description={SITE.description} path="/" signedIn>
  <Hero />
  <Trust />
  <WebPlayer />
  <div id="features">
    <Tutorial />
    <Library />
    <Listening />
    <div data-if="signed-in"><Lossless /></div>
    <Together />
  </div>
  <Faq />
  <Community />
  <FinalCta />
</BaseLayout>
