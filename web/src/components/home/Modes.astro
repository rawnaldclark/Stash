---
/**
 * The Download switch. Since v0.9.107 the app has one switch, "Download",
 * shown as "Stream only" / "Download" (Settings › Playback › Mode and the Sync
 * tab's card); the old Offline and Online modes are gone. Wording follows the
 * app: SyncHeroCard.kt, StreamingModeSheet.kt, StreamingModePrompt.kt.
 * Download mode is the default (StreamingPreference). Streaming on mobile data
 * is off until "Stream on cellular" is turned on. A playlist's own Download
 * button keeps it on the phone in either mode (PlaylistEntity.keepOffline).
 *
 * The README's "Download or stream" section says the same.
 */
import FeatureRow from '../FeatureRow.astro';
import Icon from '../Icon.astro';
---

<FeatureRow id="modes" icon="sync" overline="One switch" title="Download it, or stream it" screens={['sync']}>
  <p>
    The Download switch decides what a sync does. Songs on your phone play from your phone, and the rest
    stream.
  </p>

  <div class="modes">
    <div class="mode glass">
      <span class="icon-bubble"><Icon name="offline" size="22px" /></span>
      <div>
        <h3>Download</h3>
        <p>
          Sync saves your switched-on playlists and mixes to your phone, so they play with no connection. It
          costs storage.
        </p>
      </div>
    </div>
    <div class="mode glass">
      <span class="icon-bubble"><Icon name="cloud" size="22px" /></span>
      <div>
        <h3>Stream only</h3>
        <p>
          Sync keeps your playlists up to date without saving them, so it takes almost no storage. Songs stream
          over Wi-Fi, or over mobile data once you allow it in Settings.
        </p>
      </div>
    </div>
  </div>

  <p class="aside">Either way, a playlist's own Download button keeps that playlist on your phone.</p>
</FeatureRow>

<style>
  .modes {
    display: grid;
    gap: 14px;
    margin-top: 28px;
  }

  .mode {
    display: flex;
    gap: 16px;
    padding: 20px;
    border-radius: var(--radius-xl);
  }

  h3 {
    font-size: 1.1875rem;
  }

  .mode p {
    margin-top: 6px;
    font-size: 1rem;
    color: var(--text-2);
  }

  .aside {
    margin-top: 16px;
    font-size: 1rem;
  }
</style>
