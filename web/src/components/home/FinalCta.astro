---
/** The closing call to action. */
import DownloadCta from '../DownloadCta.astro';
import { Image } from 'astro:assets';
import vinyl from '../../assets/brand/vinyl.png';
---

<section class="section final" aria-labelledby="final-title">
  <div class="container">
    <div class="panel">
      <div class="glow" aria-hidden="true"></div>
      <Image src={vinyl} alt="" width={96} height={96} densities={[1, 2]} class="record" />
      <h2 id="final-title" class="section-title">Your library, ready when you are</h2>
      <p class="section-intro">
        Free, with no Stash account to make. Install Stash, connect Spotify or YouTube Music, and pick what to
        sync.
      </p>
      <DownloadCta />
    </div>
  </div>
</section>

<style>
  .panel {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: clamp(48px, 8vw, 96px) clamp(20px, 5vw, 64px);
    border-radius: 32px;
    border: 1px solid var(--glass-border);
    background:
      radial-gradient(80% 120% at 50% 0%, rgb(139 92 246 / 0.22), transparent 70%),
      var(--glass);
    text-align: center;
    overflow: hidden;
    isolation: isolate;
  }

  .glow {
    position: absolute;
    inset: auto 10% -40%;
    height: 80%;
    z-index: -1;
    background: radial-gradient(closest-side, var(--glow-magenta), transparent);
    pointer-events: none;
  }

  .panel :global(.record) {
    width: 96px;
    height: 96px;
    margin-bottom: 28px;
    filter: drop-shadow(0 18px 36px rgb(139 92 246 / 0.45));
  }

  @media (prefers-reduced-motion: no-preference) {
    .panel :global(.record) {
      animation: spin 12s linear infinite;
    }
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .section-intro {
    margin-inline: auto;
  }

  .panel :global(.cta) {
    margin-top: 36px;
  }

  /*
   * Small phones: the panel's padding leaves about 246px at 320px, and the
   * full-size Download button is about 276px. Trim it so it fits on one line.
   */
  @media (max-width: 360px) {
    .panel :global(.cta .download) {
      padding-inline: 16px;
      font-size: 1rem;
    }
  }
</style>
