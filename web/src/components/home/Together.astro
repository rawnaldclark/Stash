---
/**
 * The social features. Facts come from the README's "What Stash talks to"
 * (stash-share) and the code: up to 10 people in a Listen Together room
 * (infra/share-worker/src/room.js, MAX_MEMBERS), Follow or Save a copy for a
 * shared mix, and Community off until it's turned on in Home layout.
 * Names are free text the user picks ("Show my name as", up to 40 characters,
 * SharePreference): optional for Listen Together and shared mixes (others see
 * "Someone"), required for a Community post, and never checked, so the intro
 * mustn't suggest a name identifies anyone.
 */
import Icon, { type IconName } from '../Icon.astro';

const features: { icon: IconName; title: string; text: string; fact: string }[] = [
  {
    icon: 'headphones',
    title: 'Listen Together',
    text: 'Start a session and friends anywhere hear the same song at the same moment. The host runs playback and can hand it over; everyone else can suggest songs and send reactions.',
    fact: 'Up to 10 people per session',
  },
  {
    icon: 'link',
    title: 'Shared mixes',
    text: 'Share a playlist or mix as a link. Friends with Stash can follow it, so it keeps up as you add songs, or save a copy of their own.',
    fact: 'Follow it, or save a copy',
  },
  {
    icon: 'thumbs-up-down',
    title: 'Community',
    text: "Post the playlists and songs you're into, and vote on what other listeners post. Posts that get voted up rise to the top of Community's section on Home.",
    fact: 'Off until you turn it on',
  },
];
---

<section class="section together" id="together" aria-labelledby="together-title">
  <div class="glow" aria-hidden="true"></div>
  <div class="container">
    <div class="section-head is-centered">
      <p class="overline"><Icon name="group" size="18px" />Social</p>
      <h2 id="together-title" class="section-title">Music is better together</h2>
      <p class="section-intro">
        Still no Stash account. People see whatever name you choose to show.
      </p>
    </div>

    <ul role="list" class="cards">
      {
        features.map((feature) => (
          <li class="card glass">
            <span class="icon-bubble">
              <Icon name={feature.icon} size="24px" />
            </span>
            <h3>{feature.title}</h3>
            <p>{feature.text}</p>
            <p class="fact">
              <Icon name="check" size="18px" />
              {feature.fact}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .together {
    isolation: isolate;
  }

  .glow {
    position: absolute;
    inset: 10% 0;
    z-index: -1;
    background:
      radial-gradient(40% 50% at 15% 50%, var(--glow-purple), transparent 70%),
      radial-gradient(35% 45% at 85% 40%, var(--glow-magenta), transparent 70%);
    pointer-events: none;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: 28px;
    border-radius: var(--radius-2xl);
    transition:
      border-color 200ms ease,
      background-color 200ms ease,
      transform 200ms ease;
  }

  .card:hover {
    border-color: var(--glass-border-bright);
    background-color: var(--glass-hover);
    transform: translateY(-2px);
  }

  .card .icon-bubble {
    width: 52px;
    height: 52px;
    border-radius: 16px;
  }

  h3 {
    margin-top: 24px;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }

  .card p {
    margin-top: 10px;
    color: var(--text-2);
  }

  .card .fact {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 20px;
    color: var(--text);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .fact :global(.icon) {
    color: var(--cyan-dark);
  }

  @media (max-width: 900px) {
    .cards {
      grid-template-columns: 1fr;
      max-width: 560px;
      margin-inline: auto;
    }
  }
</style>
