---
/**
 * "Download for Android", "View on GitHub", and the line under them with the
 * latest version (read from GitHub at build time) and the Android requirement.
 */
import Icon from './Icon.astro';
import { getLatestRelease } from '../lib/release';
import { LINKS, SITE } from '../data/site';

interface Props {
  /** Center the buttons (hero, closing call to action) or align them left. */
  align?: 'center' | 'start';
}

const { align = 'center' } = Astro.props;
const { version } = await getLatestRelease();
---

<div class:list={['cta', `align-${align}`]}>
  <div class="buttons">
    <a class="button button-primary download" href={LINKS.download}>
      <Icon name="download" size="22px" />
      Download for Android
    </a>
    <a class="button button-secondary" href={LINKS.github}>
      <Icon name="github" size="20px" />
      View on GitHub
    </a>
  </div>
  <p class="meta">
    {
      version && (
        <>
          <span class="version">
            <span class="dot" aria-hidden="true" />
            Latest: {version}
          </span>
          <span class="sep" aria-hidden="true">·</span>
        </>
      )
    }
    <span>{SITE.minAndroid}</span>
    <span class="sep last-sep" aria-hidden="true">·</span>
    <span class="last">Free and open source</span>
  </p>
</div>

<style>
  .cta {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .align-center {
    align-items: center;
    text-align: center;
  }

  .align-start {
    align-items: flex-start;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: inherit;
  }

  .align-center .buttons {
    justify-content: center;
  }

  .download {
    min-height: 56px;
    padding-inline: 30px;
    font-size: 1.0625rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 10px;
    color: var(--text-2);
    font-size: 0.875rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .align-start .meta {
    justify-content: flex-start;
  }

  .version {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981; /* StashSuccess */
    box-shadow: 0 0 0 3px rgb(16 185 129 / 0.2);
  }

  .sep {
    color: var(--text-3);
  }

  @media (max-width: 480px) {
    .last-sep {
      display: none;
    }

    .last {
      flex-basis: 100%;
    }

    .align-center .last {
      text-align: center;
    }

    .buttons {
      flex-direction: column;
      align-self: stretch;
    }

    .buttons .button {
      width: 100%;
    }
  }
</style>
