export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  /** CSS size; defaults to 1.25em so icons scale with the text next to them. */
  size?: string;
  /** Only for icons that carry meaning on their own. Decorative icons stay hidden from screen readers. */
  label?: string;
  class?: string;
}

const { name, size = '1.25em', label, class: className } = Astro.props;
const icon = ICONS[name];
---

<svg
  class:list={['icon', className]}
  viewBox={icon.box}
  width={size}
  height={size}
  fill="currentColor"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
><path d={icon.d} /></svg>

<style>
  .icon {
    flex: none;
    display: inline-block;
    vertical-align: middle;
  }
</style>
