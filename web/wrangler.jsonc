/**
 * Cloudflare config for the stashfm.app website: a Worker with no code of its
 * own that serves the built site (./dist) with Workers Static Assets.
 * Nothing here is deployed yet. The full deploy flow is in web/README.md.
 *
 * Local check of the real thing (headers from public/_headers, 404 handling):
 *   npm run build && npx wrangler dev
 *
 * Builds: Cloudflare Workers Builds (Git integration) on this repo, with
 *   Root directory:           web
 *   Build command:            npm ci && npm run build
 *   Deploy command:           npx wrangler deploy             (master)
 *   Non-production branches:  npx wrangler versions upload    (a preview URL per branch and pull request)
 */
{
  "name": "stashfm-site",
  "compatibility_date": "2026-10-01",

  // ---------------------------------------------------------------------------
  // Production route: leave this commented out until launch.
  //
  // Today the share Worker (infra/share-worker, Worker "stash-share") owns
  // stashfm.app/*. At launch the site takes stashfm.app/*, and the share Worker
  // narrows to its own paths, which are more specific and so keep winning:
  //
  //   stashfm.app/m/*                          shared mix pages
  //   stashfm.app/t   and  stashfm.app/t/*     shared song pages
  //   stashfm.app/l/*                          Listen Together invites
  //   stashfm.app/v1/*                         the app's API (mixes, rooms, Community)
  //   stashfm.app/.well-known/assetlinks.json  Android App Links
  //
  // Order matters, or shared links break: add those routes to stash-share
  // first, then move stashfm.app/* from stash-share to this Worker.
  // ---------------------------------------------------------------------------
  // "routes": [
  //   { "pattern": "stashfm.app/*", "zone_name": "stashfm.app" }
  // ],

  "assets": {
    "directory": "./dist",
    // Unknown paths get dist/404.html with a 404 status.
    "not_found_handling": "404-page",
    // The default: /privacy serves privacy.html; /privacy.html and /privacy/ redirect to /privacy.
    "html_handling": "auto-trailing-slash"
  },

  // Keeps the workers.dev address and per-version preview URLs, which pull request previews use.
  "workers_dev": true,
  "preview_urls": true
}
