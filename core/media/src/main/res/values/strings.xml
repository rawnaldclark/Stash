<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="notification_action_like">Add to Liked Songs</string>
    <string name="notification_action_unlike">Remove from Liked Songs</string>
    <string name="notification_action_repeat_off">Repeat Off</string>
    <string name="notification_action_repeat_all">Repeat All</string>
    <string name="notification_action_repeat_one">Repeat One</string>
    <string name="notification_action_shuffle_on">Shuffle On</string>
    <string name="notification_action_shuffle_off">Shuffle Off</string>
    <string name="shuffle_play">Shuffle Play</string>
    <string name="resuming_channel_name">Playback</string>
    <string name="resuming_notification_title">Resuming…</string>
    <string name="cast_no_wifi">Can\'t cast: connect your phone to the same Wi-Fi as the speaker</string>
    <!-- The media notification's line while a linked browser plays this phone's queue (Remote v2), before the artist.
         %1$s: the browser, as linked ("Chrome on Windows"). -->
    <string name="cast_on_browser_line">On %1$s</string>

    <!-- Radio. The Start radio button on an artist page. %1$s: the artist. -->
    <string name="radio_start_artist">Start %1$s radio</string>
    <!-- Why a radio didn't start: shared by Now Playing and the Library. -->
    <string name="radio_failed_player_not_ready">Player is still starting. Try again.</string>
    <string name="radio_failed_no_station">Couldn\'t find similar songs for this.</string>
    <string name="radio_failed_download_mode">Radio streams. Switch to Online to start one.</string>

    <!-- Listen Together (spec 2026-11-04, guests add songs): toasts after a Play next or Add to queue in a session. -->
    <string name="lt_added_next">Playing next in the session</string>
    <string name="lt_added_queue">Added to the session queue</string>
    <!-- A guest's adds go to the host for approval. %1$s: the host's name. -->
    <string name="lt_suggested_to">Suggested to %1$s</string>
    <string name="lt_suggested">Suggested to the host</string>
    <!-- A guest may have this many songs waiting in the room's queue. %1$d: the limit (20). -->
    <plurals name="lt_guest_cap">
        <item quantity="one">You can have %1$d song waiting. Add more as they play.</item>
        <item quantity="other">You can have %1$d songs waiting. Add more as they play.</item>
    </plurals>
    <!-- The room's queue can't take any more (200 songs). -->
    <string name="lt_queue_full">The session queue is full</string>
    <!-- A guest's adds became suggestions, and the 3 they may have waiting are already with the host. -->
    <string name="lt_suggestions_full">The host still has your suggestions. Try again once they\'ve answered.</string>
    <!-- Play next or Add to queue while the connection to the session is down: it is sent when it comes back. -->
    <string name="lt_add_waiting">Not connected right now. It\'ll go in when you\'re back.</string>
    <!-- The song this guest added was skipped because the host's phone can't play it. %1$s: the song, %2$s: the host. -->
    <string name="lt_your_song_skipped_by">Skipped %1$s: %2$s can\'t play it</string>
    <!-- The same, when the host's name isn't known. %1$s: the song. -->
    <string name="lt_your_song_skipped">Skipped %1$s: the host can\'t play it</string>
    <!-- To the host: their phone can't play this song and nothing is queued, so the session paused. %1$s: the song. -->
    <string name="lt_stopped_cant_play">Session paused: you can\'t play %1$s</string>
    <!-- To the host: several songs in a row they can't play, so the session paused with songs still queued. %1$s: the song. -->
    <string name="lt_stopped_cant_play_more">Session paused: you can\'t play %1$s. Tap Play to try the next song.</string>
    <!-- A guest tapped a song to play it now, in a room that lets guests add. -->
    <string name="lt_only_host_changes_song">Only the host can change the song. Use Play next to add it.</string>

    <!-- Sessions (spec 2026-11-20): a station's live listening. A session refused this phone before letting it in. -->
    <!-- This app is older than the session (closes 4426). -->
    <string name="session_update_needed">Update Stash to join this session</string>
    <!-- No valid key for the session (closes 4401). -->
    <string name="session_couldnt_join">Couldn\'t join this session</string>
    <!-- The host removed this phone from the session (ended "booted", or closes 4403 on a try to come back). -->
    <string name="session_removed">You were removed from this session</string>

    <!-- Go live, tapped in a private Listen Together room. -->
    <string name="session_end_private_first">End Listen Together first</string>
    <!-- Go live, tapped while listening in someone's session. -->
    <string name="session_leave_first">Leave this session first</string>
    <!-- Go live didn't open the session: the server has Sessions switched off. -->
    <string name="session_live_off">Going live isn\'t available right now</string>
    <!-- The host's own station was removed or hidden: when going live, or when it ends the session. -->
    <string name="session_your_station_off_air">Your station is off the air</string>
    <string name="session_not_your_station">That station isn\'t yours</string>
    <!-- This phone is blocked from Community. -->
    <string name="session_live_blocked">You can\'t go live in Community</string>
    <string name="session_slow_down">Slow down a moment, then try again</string>
    <string name="session_live_failed">Couldn\'t go live. Try again.</string>
    <string name="session_live_offline">Couldn\'t go live. Check your connection and try again.</string>
</resources>
