<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Listen Together: a guest's "Play next" in a menu while the host approves each song (spec 2026-11-04).
         %1$s: the host's name. -->
    <string name="listen_suggest_to">Suggest to %1$s</string>
    <string name="listen_suggest_to_host">Suggest to the host</string>
    <!-- Sessions: a listener's "Play next" in a menu while listening to a station's session. It asks the host for the song. -->
    <string name="listen_request">Request</string>

    <!-- The vote pill (Community's posts, and stations in Sessions) -->
    <string name="vote_up">Vote up</string>
    <string name="vote_down">Vote down</string>
    <plurals name="votes">
        <item quantity="one">%d vote</item>
        <item quantity="other">%d votes</item>
    </plurals>
    <!-- TalkBack only, after a dimmed vote arrow's name ("Vote up, Listen first"): you can vote once you've listened
         (a post: 30 seconds of it; a station: 2 minutes in its sessions) -->
    <string name="vote_listen_first">Listen first</string>

    <!-- The Online/Offline sheet (opened from the mode chip on Home, Sync, album and artist pages). One short line under
         each tile's word says what the mode does. Online: everything plays; songs that aren't downloaded stream.
         Offline: only downloaded songs play. Settings > Playback shows the same two lines under its mode switch. -->
    <string name="mode_online_caption">Streams and plays downloads</string>
    <string name="mode_offline_caption">Downloads only</string>
</resources>
