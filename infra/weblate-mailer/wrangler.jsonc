{
  "name": "weblate-mailer",
  "main": "src/index.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-11-03",
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    // Fallback sender. Must be an address on a domain onboarded for Email Sending.
    // Weblate's WEBLATE_DEFAULT_FROM_EMAIL is used instead when it is on the same domain.
    "FROM_ADDRESS": "access@stashfm.app",
    "FROM_NAME": "Stash"
    // Optional: "ALLOWED_FROM_DOMAIN": "notifications.example.com"  (defaults to FROM_ADDRESS's domain)
  }
}
