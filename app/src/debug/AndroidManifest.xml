<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
        Debug builds only: the main config plus cleartext for the host of local.properties `sync.baseUrl` (a local
        stash-sync Worker), generated by app/build.gradle.kts. Release builds keep the main config: no cleartext.
    -->
    <application
        android:networkSecurityConfig="@xml/network_security_config_debug"
        tools:replace="android:networkSecurityConfig" />
</manifest>
