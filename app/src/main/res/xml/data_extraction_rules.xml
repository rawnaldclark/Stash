<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup and device-to-device transfer. allowBackup="false" stops cloud backup, but not a device-to-device transfer
    when targeting API 31+. Link Stash on the web's state (stash_sync.db, its sealed keys, the Tink keyset prefs that seal them,
    the handoff and inbox prefs, the mirror's state in no_backup/) must never move to another phone: its keys are bound to this phone's Keystore, so a copied link could
    neither be used nor cleanly removed (link-sync spec §4.4).
    The user's own add-ons (user_addons: links, tokens and their own Tidal server) are sealed with the same keys and are
    logins all the same: a new phone adds them again (add-ons phase 4 §2.10).
    What Stash keeps about add-ons goes with them: the manifests it kept (addon_manifests) name add-ons whose entries do
    not come along and would never be cleaned up, and the signed list (addon_index) is fetched again on the new phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="stash_sync.db" />
        <exclude domain="database" path="stash_sync.db-wal" />
        <exclude domain="database" path="stash_sync.db-shm" />
        <exclude domain="database" path="stash_sync.db-journal" />
        <exclude domain="sharedpref" path="stash_auth_keyset_prefs.xml" />
        <exclude domain="sharedpref" path="weblink_handoff.xml" />
        <exclude domain="sharedpref" path="weblink_inbox.xml" />
        <exclude domain="sharedpref" path="weblink_mirror.xml" />
        <exclude domain="root" path="no_backup/stash_mirror.json.gz" />
        <exclude domain="file" path="datastore/user_addons.preferences_pb" />
        <exclude domain="file" path="datastore/addon_manifests.preferences_pb" />
        <exclude domain="file" path="datastore/addon_index.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="stash_sync.db" />
        <exclude domain="database" path="stash_sync.db-wal" />
        <exclude domain="database" path="stash_sync.db-shm" />
        <exclude domain="database" path="stash_sync.db-journal" />
        <exclude domain="sharedpref" path="stash_auth_keyset_prefs.xml" />
        <exclude domain="sharedpref" path="weblink_handoff.xml" />
        <exclude domain="sharedpref" path="weblink_inbox.xml" />
        <exclude domain="sharedpref" path="weblink_mirror.xml" />
        <exclude domain="root" path="no_backup/stash_mirror.json.gz" />
        <exclude domain="file" path="datastore/user_addons.preferences_pb" />
        <exclude domain="file" path="datastore/addon_manifests.preferences_pb" />
        <exclude domain="file" path="datastore/addon_index.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
