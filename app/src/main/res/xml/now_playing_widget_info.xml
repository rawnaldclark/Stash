<?xml version="1.0" encoding="utf-8"?>
<!-- The wide "Now playing" widget: 4x1 by default, resizable. No update period: the playback
     service pushes every change (NowPlayingWidgetFeed), so the widget never wakes the phone. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_now_playing_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="40dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="40dp"
    android:previewImage="@drawable/widget_preview_wide_image"
    android:previewLayout="@layout/widget_preview_wide"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
